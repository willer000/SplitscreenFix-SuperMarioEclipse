+static bool assignedController(SDL_JoystickID id) {
+    if (!s_padBindingActive) return true;
+    SDL_GameController* c = SDL_GameControllerFromInstanceID(id);
+    if (!c) return false;
+    SDL_Joystick* j = SDL_GameControllerGetJoystick(c);
+    return SDL_JoystickGetVendor(j) == s_padVendor && SDL_JoystickGetProduct(j) == s_padProduct;
+}
+
+static void chooseAssignedRumblePad() {
+    s_rumblePad = -1;
+    for (SDL_GameController* c : s_pads) {
+        if (!SDL_GameControllerGetAttached(c)) continue;
+        SDL_JoystickID id = SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(c));
+        if (assignedController(id)) { s_rumblePad = id; break; }
+    }
+}
+
+static void readPadBinding() {
+    if (!s_padBindPath) {
+        s_padBindPath = getenv("SMS_PAD_BIND_PATH");
+        if (!s_padBindPath || !*s_padBindPath) { s_padBindPath = ""; return; }
+    }
+    if (!*s_padBindPath) return;
+    const Uint32 now = SDL_GetTicks();
+    if (s_padBindCheckedAt && now - s_padBindCheckedAt < 100) return;
+    s_padBindCheckedAt = now ? now : 1;
+    FILE* f = fopen(s_padBindPath, "rb");
+    if (!f) return; // Atomic replacement may briefly leave the path absent.
+    char line[32] = {};
+    const bool got = fgets(line, sizeof line, f) != nullptr;
+    fclose(f);
+    unsigned vendor = 0, product = 0;
+    char extra = 0;
+    if (!got || sscanf(line, "%4x:%4x %c", &vendor, &product, &extra) != 2 ||
+        !vendor || !product || vendor > 0xffff || product > 0xffff) return;
+    if (s_padBindingActive && vendor == s_padVendor && product == s_padProduct) return;
+    // Stop rumble before the old pad is released.
+    if (s_rumbling >= 0) {
+        if (SDL_GameController* old = SDL_GameControllerFromInstanceID(s_rumbling))
+            SDL_GameControllerRumble(old, 0, 0, 0);
+        s_rumbling = -1;
+        s_rumbleSent = 0;
+    }
+    s_padVendor = Uint16(vendor);
+    s_padProduct = Uint16(product);
+    s_padBindingActive = true;
+    chooseAssignedRumblePad();
+    sms_pad_release_controller();
+    fprintf(stderr, "[pad] live binding: %04x:%04x (%s)\n", vendor, product, s_rumblePad >= 0 ? "connected" : "waiting");
+    // The acknowledgement lets the launcher distinguish an applied binding
+    // from an old build that never reads this file.
+    char ack[1024];
+    if (snprintf(ack, sizeof ack, "%s.ack", s_padBindPath) < int(sizeof ack)) {
+        if (FILE* out = fopen(ack, "wb")) {
+            fprintf(out, "%04x:%04x\n", vendor, product);
+            fclose(out);
+        }
+    }
+}
 
